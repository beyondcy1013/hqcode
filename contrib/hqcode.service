[Unit]
Description=HQCode — Persistent tmux control plane for Coding Agents
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hqcode
ExecStart=/usr/local/bin/hqcode serve --addr 127.0.0.1:9900 --workspace /home/codes --data-dir /opt/hqcode/data
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
